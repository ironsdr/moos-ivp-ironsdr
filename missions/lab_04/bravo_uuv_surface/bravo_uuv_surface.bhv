//----------------------------------------------
Behavior = BHV_Waypoint
{ 
  name        = surf
  pwt         = 100
  updates     = SURF_UPDATE
  condition   = MODE==PERIOD_SURF
  inactiveflag = STATIONING = false
  activeflag = STATIONING = true
  duration = 60
  perpetual = true
  duration_reset = STATION_TIMER = true
      speed = 0
      points = 0,0 
  endflag = SURF = false
  endflag = LOITER = true
  endflag = STATION_TIMER = true
}


//DEPTH
Behavior = BHV_ConstantDepth
 {
   // General Behavior Parameters
   // ---------------------------
   name         = dpeth_east   // example
   pwt          = 100                // default
   condition    = MODE==LOITERING_EAST    // example
   updates      = DEPTH_EAST  // example

   // Parameters specific to this behavior
   // ------------------------------------
            basewidth = 100          // default
                depth = 10            // default
                duration = no-time-limit
   depth_mismatch_var = DEPTH_DIFF_1  // example
            peakwidth = 3            // default
          summitdelta = 50           // default
          perpetual = true
 }
Behavior = BHV_ConstantDepth
 {
   // General Behavior Parameters
   // ---------------------------
   name         = depth_west   // example
   pwt          = 100                // default
   condition    = MODE==LOITERING_WEST    // example
   updates      = DEPTH_WEST  // example

   // Parameters specific to this behavior
   // ------------------------------------
            basewidth = 100          // default
                depth = 30            // default
                duration = no-time-limit
   depth_mismatch_var = DEPTH_DIFF_2   // example
            peakwidth = 3            // default
          summitdelta = 50           // default
          perpetual = true
}
Behavior = BHV_ConstantDepth
 {
   // General Behavior Parameters
   // ---------------------------
   name         = depth_general   // example
   pwt          = 100                // default
   condition = MODE==RETURNING
   updates      = DEPTH_GENERAL  // example

   // Parameters specific to this behavior
   // ------------------------------------
            basewidth = 100          // default
                depth = 0            // default
   depth_mismatch_var = DEPTH_DIFF_3   // example
   duration = no-time-limit
            peakwidth = 3            // default
          summitdelta = 50           // default
}
Behavior = BHV_ConstantDepth
 {
   // General Behavior Parameters
   // ---------------------------
   name         = depth_surf   // example
   pwt          = 100                // default
   condition = MODE==PERIOD_SURF
   updates      = DEPTH_SURF  // example

   // Parameters specific to this behavior
   // ------------------------------------
            basewidth = 100          // default
                depth = 0            // default
   depth_mismatch_var = DEPTH_DIFF_4   // example
   duration = no-time-limit
            peakwidth = 3            // default
          summitdelta = 50           // default
}
//TIMERS
Behavior = BHV_Timer
 {
   // General Behavior Parameters
   // ---------------------------
   name         = 200_surf            // default
   condition = SURF==false
   duration     = 200                  // example
   perpetual = true
   endflag = SURF=true
   endflag = LOITER = false
   // Parameters specific to this behavior
   // ------------------------------------
   // None
 }
