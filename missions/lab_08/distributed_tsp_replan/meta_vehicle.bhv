//----------------------------------------------
Behavior = BHV_Waypoint
{
  name      = waypt_survey
  pwt       = 100
  condition = MODE==SURVEYING
  perpetual = true
  updates   = WPT_UPDATE
  endflag   = RETURN = true

        speed = 1.2        
       radius = 3.0
  slip_radius = 25.0
points = 0,-20:0,-21
}


//----------------------------------------------
Behavior = BHV_Waypoint
{
  name      = waypt_return
  pwt       = 100
  condition = (MODE==RETURNING)
  perpetual = true
  endflag   = STATION_KEEP = true
  endflag = GENPATH_REGENERATE = true
  // endflag = RETURN = false        // Stop returning

      speed = 1.3
     radius = 3.0
  nm_radius = 15.0
     points = $(START_POS)
       lead = 8
}

Behavior = BHV_Waypoint
{
  name      = waypt_gas
  pwt       = 100
  condition = (MODE==GOING_FOR_GAS) and (AT_GAS_STATION == false)
  perpetual = true
  endflag   = AT_GAS_STATION = true

      speed = 1.3
     radius = 3.0
  nm_radius = 15.0
     points = $(START_POS)
       lead = 8
}

//----------------------------------------------
Behavior = BHV_StationKeep
{
  name      = station-keep-manual
  pwt       = 100
  condition = (MODE==STATION-KEEPING-MANUAL)

   center_activate = true
      inner_radius = 5
      outer_radius = 10
       outer_speed = 1.0
     transit_speed = 1.3
        swing_time = 7
      visual_hints = vertex_size=0, edge_color=gray50
}

Behavior = BHV_StationKeep
{
  name      = station-keep-refuel
  pwt       = 100
  condition = (AT_GAS_STATION == true)

  duration       = 60
  perpetual      = true
  duration_reset = REFUEL_NEEDED=true
  endflag        = REFUEL_NEEDED = false
  endflag        = AT_GAS_STATION = false

   center_activate = true
      inner_radius = 5
      outer_radius = 10
       outer_speed = 1.0
     transit_speed = 1.3
        swing_time = 7
      visual_hints = vertex_size=0, edge_color=gray50
}



Behavior = BHV_Timer
{
  name      = background_fuel_timer


  condition = DEPLOY == true
  condition = STATION_KEEP == false
  condition = AT_GAS_STATION == false
  condition = MODE==SURVEYING

  duration       = 200000
  perpetual      = true

  // when timer is done, you need gas
  endflag        = REFUEL_NEEDED = true

  //after station keeping for gas is done (60 sec later), it makes refuel_needed = false, which should reset the timer
  duration_reset = REFUEL_NEEDED = false

}
