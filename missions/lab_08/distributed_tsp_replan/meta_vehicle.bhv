//-----------------------------------------------
// Helm Behavior file

initialize   DEPLOY  = true
initialize   RETURN  = false
initialize   STATION_KEEP = false
initialize   SURVEY  = true
initialize   REFUEL_NEEDED = false
initialize   AT_GAS_STATION = false

set MODE = ACTIVE {
  DEPLOY = true
} INACTIVE

set MODE = STATION-KEEPING-MANUAL {
  MODE = ACTIVE
  STATION_KEEP = true
}

set MODE = RETURNING {
  MODE = ACTIVE
  RETURN = true
}

set MODE = GOING_FOR_GAS {
  MODE = ACTIVE
  REFUEL_NEEDED = true
}

set MODE = LOITERING {
  MODE = ACTIVE
  LOITER = true
}

set MODE = SURVEYING {
  MODE = ACTIVE
  SURVEY = true
}



