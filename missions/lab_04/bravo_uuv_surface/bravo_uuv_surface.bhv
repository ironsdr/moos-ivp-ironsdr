// Name: D. Irons
//--------    FILE: bravo_uuv_surface.bhv   -------------

initialize   DEPLOY = false
initialize   RETURN = false
initialize   LOITER = true
initialize   REGION = east
initialize   SURF = false
set MODE = ACTIVE {
  DEPLOY = true
} INACTIVE

set MODE = RETURNING {
  MODE = ACTIVE
  RETURN = true
} 

set MODE = LOITERING_EAST {
  MODE = ACTIVE
  LOITER = true
  REGION = east
  SURF = false
} 

set MODE = LOITERING_WEST {
  MODE = ACTIVE
  LOITER = true
  REGION = west
  SURF =false
}

set MODE = PERIOD_SURF {
  MODE = ACTIVE
  LOITER = false
  SURF = true
}


//----------------------------------------------
Behavior = BHV_Waypoint
{ 
  name        = waypt_return
  pwt         = 100
  updates     = RETURN_UPDATES
  condition   = MODE==RETURNING
  endflag     = RETURN = false
  endflag     = DEPLOY = false
  endflag     = MISSION = complete
	
      speed = 2.5
      point = 0,-20
}

//------------------------------------------------
Behavior = BHV_Loiter
 {
   // General Behavior Parameters
   // ---------------------------
   name         = loiter_east               // example
   pwt          = 100                   // default
   condition    = MODE==LOITERING_EAST       // example
   updates      = UP_LOITER_E        // example
   duration_reset = EAST_TIMER = true
   duration_idle_decay = false
   // Parameters specific to this behavior
   // ------------------------------------
        acquire_dist = 10               // default
      capture_radius = 3                // default  
     center_activate = false            // default
           clockwise = best             // default
         slip_radius = 15               // default
               speed = 2.5                // default
       spiral_factor = -2               // default
        polygon = radial:: x=160,y=-50,radius=20,pts=8  // example
        post_suffix = EAST                             // example
        perpetual=true
        visual_hints = vertex_size  = 1             // default
        visual_hints = edge_size    = 1             // default
        visual_hints = vertex_color = dodger_blue   // default
        visual_hints = edge_color   = white         // default
        visual_hints = nextpt_color = yellow        // default
        visual_hints = nextpt_lcolor = aqua         // default
        visual_hints = nextpt_vertex_size = 5       // default
        visual_hints = label        = zone_east         // example
        duration = 250
        endflag = EAST_TIMER = true
        endflag = REGION = west
}

//------------------------------------------------
Behavior = BHV_Loiter
 {
   // General Behavior Parameters
   // ---------------------------
   name         = loiter_west               // example
   pwt          = 100                   // default
   condition    = MODE==LOITERING_WEST       // example
   updates      = UP_LOITER_W       // example
   duration_reset = WEST_TIMER = true
   duration_idle_decay = false
   // Parameters specific to this behavior
   // ------------------------------------
        acquire_dist = 10               // default
      capture_radius = 3                // default  
     center_activate = false            // default
           clockwise = best             // default
         slip_radius = 15               // default
               speed = 2.5                // default
       spiral_factor = -2               // default
        polygon = radial:: x=100,y=-75,radius=30,pts=8  // example
        post_suffix = WEST                             // example
        perpetual = true
        visual_hints = vertex_size  = 1             // default
        visual_hints = edge_size    = 1             // default
        visual_hints = vertex_color = dodger_blue   // default
        visual_hints = edge_color   = white         // default
        visual_hints = nextpt_color = yellow        // default
        visual_hints = nextpt_lcolor = aqua         // default
        visual_hints = nextpt_vertex_size = 5       // default
        visual_hints = label        = zone_west         // example
        duration = 150
        endflag = WEST_TIMER = true
        endflag = REGION = east
}
