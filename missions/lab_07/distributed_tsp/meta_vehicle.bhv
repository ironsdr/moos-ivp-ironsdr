//-----------------------------------------------
// Helm Behavior file 

initialize   DEPLOY  = true
initialize   RETURN  = false
initialize   STATION_KEEP = false
initialize   LOITER  = false
initialize   REFUEL_NEEDED = false
initialize   REFUELING = false
initialize   TSP = false

set MODE = ACTIVE {
  DEPLOY = true
} INACTIVE

set MODE = REFUEL_TRANSIT {
  MODE = ACTIVE
  REFUEL_NEEDED = true
  REFUELING = false
}
set MODE = REFUEL {
  MODE = ACTIVE
  REFUEL_NEEDED = true
  REFUELING = true
}

set MODE = STATION-KEEPING {
  MODE = ACTIVE
  STATION_KEEP = true
  REFUELING = false
}                       

set MODE = RETURNING {
  MODE = ACTIVE
  RETURN = true
} 

set MODE = LOITERING {
  MODE = ACTIVE
  LOITER = true
  TSP = false
  REFUEL_NEEDED = false
  REFUELING = false
} 
set MODE = TSP_ACTIVE {
  MODE = ACTIVE
  TSP = true
  LOITER = false
  REFUEL_NEEDED = false
  REFUELING = false
}

//----------------------------------------------
Behavior = BHV_Loiter
{
  name      = loiter
  pwt       = 100
  condition = MODE==LOITERING
  condition = STATION_KEEP = false
  duration = 300
  duration_reset = refuel-need-timer = true
  perpetual = true
  duration_idle_decay = false
  endflag = REFUEL_NEEDED = true

   post_suffix = A
         speed = 1.3
     clockwise = false
        radius = 8.0
     nm_radius = 15.0
       polygon = radial::$(LOITER_POS), radius=20, pts=8, snap=1, label=$(VNAME)_LOITER

  visual_hints = nextpt_color=white, nextpt_lcolor=khaki
  visual_hints = edge_color=orange, vertex_color=white
  visual_hints = edge_size=1, vertex_size=2
}

//----------------------------------------------
Behavior = BHV_Waypoint
{
  name      = tsp_waypt
  pwt       = 100
  condition = MODE==TSP_ACTIVE
  condition = STATION_KEEP = false
  perpetual = true
  endflag   = REFUEL_NEEDED = true
  cycleflag = TOUR_COMPLETE = true
  updates   = TSP_UPDATES

      speed = 1.3
     radius = 3.0
     slip_radius = 15
  nm_radius = 15.0
     points = $(START_POS)
       lead = 8
}

//----------------------------------------------
Behavior = BHV_Waypoint
{
  name      = waypt_return
  pwt       = 100
  perpetual = true
  condition = MODE==RETURNING
  endflag   = STATION_KEEP = true

      speed = 1.3
     radius = 3.0
  nm_radius = 15.0
     points = $(START_POS)
       lead = 8
}


//----------------------------------------------
Behavior = BHV_StationKeep
{
  name         = station_keep
  pwt          = 100
  perpetual    = true
  condition    = MODE==STATION-KEEPING

   center_activate = true
       inner_radius = 5
       outer_radius = 10
        outer_speed = 1.0
      transit_speed = 1.3
         swing_time = 7
       visual_hints = vertex_size=0, edge_color=gray50
}

//----------------------------------------------
Behavior = BHV_Waypoint
{
  name      = refuel_transit
  pwt       = 100
  condition = MODE==REFUEL_TRANSIT
  perpetual = true
  endflag   = REFUELING = true

      speed = 1.3
     radius = 3.0
  nm_radius = 15.0
     points = $(START_POS)
       lead = 8
}
//----------------------------------------------
Behavior = BHV_StationKeep
{
  name      = charging
  pwt       = 100
  condition = MODE==REFUEL
  perpetual = true
  duration = 60
  duration_reset = refueling-timer = true
  duration_idle_decay = false

  endflag = REFUEL_NEEDED = false
  endflag = REFUELING = false
  endflag = refueling-timer = true
  endflag = refuel-need-timer = true
   center_activate = true
      inner_radius = 5
      outer_radius = 10 
       outer_speed = 1.0
     transit_speed = 1.3
        swing_time = 7
      visual_hints = vertex_size=0, edge_color=gray50

}
Behavior = BHV_Timer
 {
   name         = bhv_timer
   condition    = (LOITER = true) or (TSP = true)
   duration     = 600
   perpetual    = true
   duration_reset = refuel-need-timer = true
   duration_idle_decay = false
   endflag      = REFUEL_NEEDED = true
   updates      = REFUEL_TIMER
 }

